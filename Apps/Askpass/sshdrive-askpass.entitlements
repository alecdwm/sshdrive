<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately empty. The CLI and askpass are bare executables in Contents/MacOS: they
	  cannot embed a provisioning profile and need no entitlement, because both are pure
	  XPC clients of the agent (docs/design/components.md,
	  docs/design/secrets.md). They carry the hardened
	  runtime, which is a build setting, and nothing else.
	-->
</dict>
</plist>
