<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SSH Drive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>RWGDZAYBM8.org.shirls.sshdrive</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
		<!--
		  Pin and unpin get their own Finder context-menu entries, shown conditionally on
		  pin state (DESIGN.md sections 2, 7.2). Handled since milestone 8 in
		  NSFileProviderCustomAction.performAction, which forwards to the agent; the
		  identifiers are also in XPCProtocols/Identifiers.swift and must be edited
		  together. S6 recorded where Finder puts them: at the very bottom of the
		  contextual menu, at the top level, one of the pair at a time, and on the window
		  background but never on the sidebar row.

		  The bound key is "fileproviderItems", lower-case p, and it is a key path on the
		  evaluated object, not a substitution variable: "$fileProviderItems" throws
		  "Can't get value for 'fileProviderItems' in bindings {}" and the whole rule is
		  then dropped. It is the only spelling in the dyld shared cache (s6-8,
		  2026-09-04). The rules are the "at least one" form of section 7.2, so a mixed
		  selection shows both entries; that form is also false on an empty selection,
		  where the "all selected items" form ("SUBQUERY(...).@count ==
		  fileproviderItems.@count") would be 0 == nil-count, i.e. true, and would show
		  both entries at once.
		-->
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>org.shirls.sshdrive.action.pin</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Keep Downloaded</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.userInfo.kept == 0).@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>org.shirls.sshdrive.action.unpin</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Don't Keep Downloaded</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.userInfo.kept == 1).@count &gt; 0</string>
			</dict>
		</array>
		<!--
		  Section 7.2's pin badge. A decoration is declared here and attached to an item
		  through NSFileProviderItemDecorating.decorations (Item.swift), which serves it
		  for every *kept* item - the effect, not the marker, so an excluded folder inside
		  a kept one shows nothing and its parent still does (section 7.1.1).

		  The keys are the four NSFileProviderItemDecoration.h names, not
		  NSFileProviderDecoration*-prefixed ones: Identifier, BadgeImageType, Label and
		  Category. BadgeImageType is a UTI that must conform to
		  com.apple.icon-decoration.badge; com.apple.icon-decoration.badge.pinned is a
		  system one, so no icon asset and no exported type of ours is needed. Category
		  "Badge" draws on top of the icon for a file or a folder alike ("FolderBadge"
		  would emboss, and is valid for folders only).
		-->
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>org.shirls.sshdrive.decoration.kept</string>
				<key>BadgeImageType</key>
				<string>com.apple.icon-decoration.badge.pinned</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Kept downloaded by SSH Drive</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
